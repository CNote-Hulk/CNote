# Console Notebook - Server Environment Variables
# Copy this file to .env and fill in the values.
# DO NOT commit .env — it is gitignored. This file (.env.example) is safe to commit.

# ── Server ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Railway production: set NODE_ENV=production
API_BASE_URL=http://localhost:3000/api
BASE_URL=http://localhost:3000
FRONTEND_URL=https://andreihalcu07-blip.github.io

# ── Database ─────────────────────────────────────────────────
# Supabase / Postgres connection string
DATABASE_URL=postgresql://user:password@host:5432/postgres

# ── Supabase Storage (avatar uploads) ─────────────────────────
# https://supabase.com/dashboard/project/_/settings/api
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS — keep it server-side only, never expose to the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Chat attachment storage (self-hosted MinIO — images + voice messages) ────
# Runs on our own VPS, NOT Supabase (Supabase Storage free tier is 1GB, not
# enough for chat media). See /infra/README.md for how to stand up the server.
# OBJECT_STORAGE_ENDPOINT: the MinIO S3 API endpoint, e.g. https://storage.consolenotebook.com
# OBJECT_STORAGE_PUBLIC_URL: base URL objects are fetched from by clients — same
#   host as above unless you put a CDN in front of it later.
OBJECT_STORAGE_ENDPOINT=https://storage.consolenotebook.com
OBJECT_STORAGE_PUBLIC_URL=https://storage.consolenotebook.com/cnote-chat
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=cnote-chat
OBJECT_STORAGE_ACCESS_KEY=your-minio-access-key-here
OBJECT_STORAGE_SECRET_KEY=your-minio-secret-key-here
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# ── Auth ─────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-jwt-secret-here

# ── Email ──────────────────────────────────────────────────
CONTACT_RECEIVER_EMAIL=your-contact-receiver@example.com

# ── Resend (transactional email) ─────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# ── Google OAuth 2.0 ─────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# ── eBay Marketplace API ─────────────────────────────────────
# https://developer.ebay.com/my/keys

EBAY_CLIENT_ID=your-ebay-client-id-here
EBAY_CLIENT_SECRET=your-ebay-client-secret-here
EBAY_RU_NAME=your-ebay-runame-here
EBAY_VERIFICATION_TOKEN=your-verification-token-here
EBAY_DELETION_ENDPOINT_URL=https://consolenotebook.com/api/ebay/account-deletion

# ── DSA Article 16 — Content Reporting ──────────────────────
# Admin email that receives notifications for new content reports
ADMIN_EMAIL=admin@yourdomain.com

# ── OLX API ──────────────────────────────────────────────────

OLX_CLIENT_ID=your-olx-client-id-here
OLX_CLIENT_SECRET=your-olx-client-secret-here
OLX_REDIRECT_URI=your-olx-redirect-uri-here

# ── Firebase Admin (FCM push notifications — DM chat) ─────────
# https://console.firebase.google.com/ → Project settings → Service accounts →
# Generate new private key. Use the JSON fields projectId/clientEmail/privateKey.
# If unset, push notifications are silently disabled (server still starts normally).
# FIREBASE_PRIVATE_KEY must keep its literal \n sequences — the code unescapes them.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ── Cloudflare Turnstile (CAPTCHA on registration + contact form) ────
# https://dash.cloudflare.com/?to=/:account/turnstile — create a widget,
# copy its Site Key (public, safe in HTML) and Secret Key (server-only).
# The values below are Cloudflare's published "always passes" TEST keys —
# fine for local dev, but MUST be swapped for real ones before deploying,
# or registration/contact submissions will not actually be protected.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ── Sentry Error Tracking ─────────────────────────────────────
# https://sentry.io — create a Node.js project for backend, Browser JS for frontend
# Backend DSN (server-side only)
SENTRY_DSN_BACKEND=your-sentry-backend-dsn-here
# Frontend DSN (injected into HTML at request time; Sentry expects this to be visible in the browser)
SENTRY_DSN_FRONTEND=your-sentry-frontend-dsn-here
