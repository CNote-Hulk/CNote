# Console Notebook — Server Environment Variables
# Copy this file to .env and fill in the values.

# Server port (default: 3000)
PORT=3000

# Runtime mode (development | production)
NODE_ENV=development

# Allowed frontend origin for CORS (GitHub Pages domain)
FRONTEND_URL=https://andreihalcu07-blip.github.io

# Public URL for email links (used in verification/reset emails)
BASE_URL=http://localhost:3000

# PostgreSQL connection string (Supabase)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# JWT Secret (for signing authentication tokens)
JWT_SECRET=

# Resend API Key (for sending emails)
# Get your key at https://resend.com/api-keys
RESEND_API_KEY=
