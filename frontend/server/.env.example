# Console Notebook — Server Environment Variables
# Copy this file to .env and fill in the values.

# Server port (default: 3000)
PORT=3000

# Runtime mode (development | production)
NODE_ENV=development

# Allowed frontend origin for CORS (GitHub Pages domain)
FRONTEND_URL=https://andreihalcu07-blip.github.io

# Public URL for email links (used in verification/reset emails)
BASE_URL=http://localhost:3000

# Optional SQLite path override (default: ./data/console_notebook.db)
DB_PATH=

# SMTP Configuration (for sending emails)
# If not set, emails are logged to the console in dev mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Console Notebook <noreply@consolenotebook.ro>
