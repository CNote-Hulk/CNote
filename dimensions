    <section class="video-section">
      <div class="custom-player" data-video-id="[YOUTUBE_ID]">
        <div class="yt-placeholder"></div>
        <div class="player-overlay">
          <button class="overlay-play-btn">...</button>
        </div>
        <div class="player-controls">...</div>
      </div>
      <p class="video-description">...</p>
    </section>

  The video-id is a 11-character YouTube ID from the URL:
    youtube.com/watch?v=[THIS_PART]

